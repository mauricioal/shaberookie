# Renshuu API configuration
RENSHUU_API_BASE=https://api.renshuu.org/v1
RENSHUU_API_KEY=your_renshuu_api_key_here

# LLM provider configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# Application settings
LOG_LEVEL=INFO
LOG_DIR=logs
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=900
PROFILE_STORE_PATH=data/profiles
CONVERSATION_LOG_PATH=data/conversations

# Gradio settings
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# Redis cache (optional)
REDIS_URL=redis://localhost:6379/0